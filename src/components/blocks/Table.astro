---
const { caption, headers = [], rows = [] } = Astro.props;
---
<section><div class="wrap reveal" style="overflow-x:auto">
  <table class="pricetable">
    {caption && <caption style="caption-side:top;text-align:left;font-family:var(--serif);font-size:1.4rem;margin-bottom:14px">{caption}</caption>}
    {headers.length > 0 && (
      <thead><tr>{headers.map((h: string) => <th>{h}</th>)}</tr></thead>
    )}
    <tbody>
      {rows.map((r: any) => (
        <tr>{(r.cells || []).map((c: string) => <td>{c}</td>)}</tr>
      ))}
    </tbody>
  </table>
</div></section>
