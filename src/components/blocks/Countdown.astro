---
import { withBase } from '../../lib/url';
const { title, targetDate, note, ctaLabel, ctaHref } = Astro.props;
---
<section class="spaces"><div class="wrap reveal" style="text-align:center">
  {title && <h2>{title}</h2>}
  <div class="countdown" data-target={targetDate} style="display:flex;gap:22px;justify-content:center;margin:26px 0;flex-wrap:wrap">
    {['d', 'h', 'm', 's'].map((u) => (
      <div>
        <span class={`cd-${u}`} style="font-family:var(--serif);font-size:clamp(2.2rem,6vw,3.4rem);color:var(--terracotta);display:block;font-variant-numeric:tabular-nums">–</span>
        <span style="font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)">{u === 'd' ? 'jours' : u === 'h' ? 'heures' : u === 'm' ? 'min' : 'sec'}</span>
      </div>
    ))}
  </div>
  {note && <p style="color:var(--ink-soft)">{note}</p>}
  {ctaLabel && ctaHref && <div style="margin-top:18px"><a href={withBase(ctaHref)} class="btn btn-primary">{ctaLabel}</a></div>}
</div></section>
<script>
  document.querySelectorAll('.countdown').forEach((el) => {
    const t = new Date(el.getAttribute('data-target') || '').getTime();
    if (isNaN(t)) return;
    const set = (c, v) => { const n = el.querySelector(c); if (n) n.textContent = v; };
    const tick = () => {
      const d = Math.max(0, t - Date.now());
      set('.cd-d', Math.floor(d / 86400000));
      set('.cd-h', String(Math.floor(d / 3600000) % 24).padStart(2, '0'));
      set('.cd-m', String(Math.floor(d / 60000) % 60).padStart(2, '0'));
      set('.cd-s', String(Math.floor(d / 1000) % 60).padStart(2, '0'));
    };
    tick(); setInterval(tick, 1000);
  });
</script>
