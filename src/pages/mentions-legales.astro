---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title={`Mentions légales — ${site.name}`} description="Mentions légales du site du Gîte de la Mare Ronde." path="/mentions-legales/">
  <section class="page-hero"><div class="wrap">
    <p class="breadcrumb"><a href="/">Accueil</a> › Mentions légales</p>
    <h1>Mentions légales</h1>
  </div></section>
  <section><div class="wrap prose reveal">
    <h2>Éditeur</h2>
    <p>{site.name} — {site.city} ({site.postalCode}). <em>(Raison sociale, SIRET, directeur de publication à compléter.)</em></p>
    <h2>Hébergement</h2>
    <p><em>(Nom et coordonnées de l'hébergeur à compléter.)</em></p>
    <h2>Propriété intellectuelle</h2>
    <p>L'ensemble des contenus de ce site est protégé. Toute reproduction sans autorisation est interdite.</p>
  </div></section>
</BaseLayout>
