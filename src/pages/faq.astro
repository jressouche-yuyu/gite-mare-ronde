---
import V3Layout from '../layouts/V3Layout.astro';
import { withBase } from '../lib/url';
import data from '../content/faqpage/faqpage.json';

const seo = (data as any).seo ?? {};
const { hero, items, cta } = data as any;
const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: items.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<V3Layout
  title={seo.metaTitle || data.title}
  description={seo.metaDescription || ''}
  path="/faq/"
  noindex={seo.noindex}
  jsonld={faqJsonLd}
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
  </div></section>

  <section class="v-sec"><div class="v-wrap">
    <div class="v-faq v-reveal">
      {items.map((f: any) => (<details><summary>{f.q}</summary><div class="ans">{f.a}</div></details>))}
    </div>
  </div></section>

  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>{cta.heading}</h2>
    <p>{cta.text}</p>
    <a href={withBase(cta.buttonHref)} class="v-btn v-btn-ghost" style="border-color:rgba(255,255,255,.7)">{cta.buttonLabel}</a>
  </div></section>
</V3Layout>
