---
import V3Layout from '../layouts/V3Layout.astro';
import { site } from '../data/site';
import { booking } from '../data/booking';
import { listings } from '../data/listings';
import { withBase } from '../lib/url';
import home from '../content/home/home.json';

const seo = (home as any).seo ?? {};
const { hero, domaine, spaces, region, reviewsSection, faqSection, cta } = home as any;
const paras = (s: string) => String(s || '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: (faqSection.items || []).map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<V3Layout
  title={seo.metaTitle || site.name}
  description={seo.metaDescription || site.description}
  path="/"
  ogImage={hero?.image?.src || '/uploads/domaine/01.jpg'}
  noindex={seo.noindex}
  jsonld={faqJsonLd}
  heroHeader
>
  <!-- HERO -->
  <section class="v-hero">
    <div class="photo"><img src={withBase(hero.image?.src)} alt={hero.image?.alt || ''} /></div>
    <div class="v-wrap">
      <p class="v-eyebrow">{hero.eyebrow}</p>
      <h1>{hero.title}</h1>
      <div class="v-rule"></div>
      <p class="lede">{hero.lede}</p>
      <div class="actions">
        <a href={withBase('/nos-gites/')} class="v-btn v-btn-primary">{hero.ctaPrimaryLabel}</a>
        <a href={booking.primary} target="_blank" rel="noopener" class="v-btn v-btn-ghost">{hero.ctaSecondaryLabel}</a>
      </div>
    </div>
  </section>

  <!-- NOTRE DOMAINE -->
  <section class="v-sec"><div class="v-wrap v-story v-reveal">
    <div class="imgs">
      <img src={withBase(domaine.image1?.src)} alt={domaine.image1?.alt || ''} />
      <img src={withBase(domaine.image2?.src)} alt={domaine.image2?.alt || ''} />
    </div>
    <div>
      <p class="v-eyebrow">{domaine.eyebrow}</p>
      <h2>{domaine.heading}</h2>
      {paras(domaine.body).map((p) => <p>{p}</p>)}
      <a href={withBase('/nos-gites/')} class="v-btn v-btn-dark" style="margin-top:8px">Découvrir les 3 gîtes</a>
    </div>
  </div></section>

  <!-- 3 GÎTES (cartes enrichies V1) -->
  <section class="v-sec alt"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Nos hébergements</p><h2>Trois gîtes, un même domaine</h2><div class="v-rule"></div><p>Le domaine entier pour vos grandes occasions, ou un appartement pour une escapade intime.</p></div>
    <div class="v-gites">
      {listings.map((l) => (
        <article class={`v-gcard v-reveal${l.featured ? ' featured' : ''}`}>
          <a href={withBase(`/gites/${l.slug}/`)} class="ph"><img src={withBase(l.photos[0])} alt={l.name} loading="lazy" /></a>
          <div class="hd"><span class="tag">{l.type}</span>{l.name}</div>
          <div class="bd">
            <p class="tagline">{l.tagline}</p>
            <div class="v-specs">
              <span>👥 {l.capacity} pers.</span>
              {l.bedrooms && <span>🛏 {l.bedrooms}</span>}
              {l.baths && <span>🛁 {l.baths}</span>}
            </div>
            <div class="links">
              <a href={withBase(`/gites/${l.slug}/`)} class="v-btn v-btn-dark" style="padding:10px 16px">Découvrir</a>
              <a href={l.airbnb} target="_blank" rel="noopener" class="v-btn v-btn-book" style="padding:10px 16px">Réserver</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <!-- À VIVRE -->
  <section class="v-sec"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">À vivre</p><h2>{spaces.heading}</h2><div class="v-rule"></div><p>{spaces.intro}</p></div>
    <div class="v-spaces v-reveal">
      {spaces.cards.map((c: any) => (
        <article class="sp">
          <div class="ph"><img src={withBase(c.image?.src)} alt={c.image?.alt || ''} loading="lazy" /></div>
          <div class="bd"><h3>{c.title}</h3><p>{c.text}</p></div>
        </article>
      ))}
    </div>
    <div class="v-amenrow v-reveal">
      {spaces.equipment.map((e: any) => (<span class="chip"><span class="em">{e.icon}</span>{e.name}</span>))}
    </div>
  </div></section>

  <!-- BANDEAU -->
  <div class="v-band"><img src={withBase('/uploads/domaine/02.jpg')} alt="Le bord de la piscine au soleil, face à la ferme" /></div>

  <!-- RÉGION -->
  <section class="v-sec alt"><div class="v-wrap v-2col v-reveal">
    <iframe class="v-mapframe" loading="lazy" title="Carte — Yvré-l'Évêque" src="https://www.google.com/maps?q=Yvr%C3%A9-l%27%C3%89v%C3%AAque%2C%20Sarthe&output=embed"></iframe>
    <div>
      <p class="v-eyebrow">{region.eyebrow}</p>
      <h2>{region.heading}</h2>
      {paras(region.body).map((p) => <p set:html={p.replace(/circuit des 24 Heures du Mans/i, '<strong>circuit des 24 Heures du Mans</strong>')} />)}
    </div>
  </div></section>

  <!-- TÉMOIGNAGES -->
  <section class="v-sec"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Ils ont séjourné chez nous</p><h2>{reviewsSection.heading}</h2><div class="v-rule"></div></div>
    <div class="v-revs v-reveal">
      {reviewsSection.items.map((r: any) => (
        <div class="v-rev"><div class="stars">{'★'.repeat(r.stars || 5)}</div><p>« {r.text} »</p><div class="who">{r.who} · {r.via}</div></div>
      ))}
    </div>
  </div></section>

  <!-- FAQ -->
  <section class="v-sec alt"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Bon à savoir</p><h2>{faqSection.heading}</h2><div class="v-rule"></div></div>
    <div class="v-faq v-reveal">
      {faqSection.items.map((f: any) => (
        <details><summary>{f.q}</summary><div class="ans">{f.a}</div></details>
      ))}
    </div>
  </div></section>

  <!-- CTA -->
  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>{cta.heading}</h2>
    <p>{cta.text}</p>
    <div class="actions" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href={booking.primary} target="_blank" rel="noopener" class="v-btn v-btn-book">Réserver sur Airbnb</a>
      <a href={withBase('/contact/')} class="v-btn v-btn-ghost" style="border-color:rgba(255,255,255,.7)">Nous contacter</a>
    </div>
  </div></section>
</V3Layout>
