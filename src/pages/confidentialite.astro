---
import V3Layout from '../layouts/V3Layout.astro';
import data from '../content/legal/confidentialite.json';

const seo = (data as any).seo ?? {};
const { heroTitle, sections } = data as any;
---
<V3Layout title={seo.metaTitle || data.title} description={seo.metaDescription || ''} path="/confidentialite/" noindex={seo.noindex}>
  <section class="v-phero"><div class="v-wrap">
    <h1>{heroTitle}</h1>
  </div></section>
  <section class="v-sec"><div class="v-wrap v-prose v-reveal" style="margin:0 auto">
    {sections.map((s: any) => (<><h2>{s.heading}</h2><p set:html={(s.body || '').replace(/\n/g, '<br>')} /></>))}
  </div></section>
</V3Layout>
