---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listings } from '../../data/listings';
import { site } from '../../data/site';

export function getStaticPaths() {
  return listings.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const others = listings.filter((x) => x.slug !== l.slug);
const path = `/hebergements/${l.slug}/`;
const title = `${l.name} — ${l.type} à ${site.city}`;
const description = l.intro.slice(0, 155);
const cover = l.photos[0];
const gallery = l.photos.slice(1, 19); // limite à 18 photos pour la performance
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Accommodation',
    name: l.name, description: l.intro,
    occupancy: { '@type': 'QuantitativeValue', maxValue: l.capacity },
    numberOfBedrooms: l.bedrooms, url: new URL(path, site.domain).href,
    image: l.photos.slice(0, 8).map((p) => new URL(p, site.domain).href),
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: l.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<BaseLayout title={title} description={description} path={path} jsonld={jsonld}>
  <!-- HERO 2 colonnes -->
  <section class="page-hero">
    <div class="wrap lhero">
      <div>
        <p class="breadcrumb"><a href="/">Accueil</a> › <a href="/hebergements/">Hébergements</a> › {l.name}</p>
        <p class="eyebrow">{l.type}</p>
        <h1>{l.name}</h1>
        <p class="tagline">{l.tagline}</p>
        <div class="specs">
          <span>👥 {l.capacity} voyageurs</span>
          {l.bedrooms && <span>🛏 {l.bedrooms}</span>}
          {l.baths && <span>🛁 {l.baths}</span>}
        </div>
        <div style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap;align-items:center">
          <a href={l.airbnb} target="_blank" rel="noopener" class="btn btn-book">Réserver sur Airbnb</a>
          <a href="/prix/" class="btn btn-ghost">Voir les prix</a>
        </div>
      </div>
      <div class="cover-wrap"><img class="cover" src={cover} alt={`${l.name} — ${site.city}`} /></div>
    </div>
  </section>

  <!-- LE LOGEMENT -->
  <section><div class="wrap" style="display:grid;grid-template-columns:1.5fr .8fr;gap:54px;align-items:start">
    <div class="prose reveal">
      <p class="eyebrow">Le logement</p>
      <h2>{l.name}</h2>
      {l.long.map((p) => <p>{p}</p>)}
      <h3>Les points forts</h3>
      <ul>{l.highlights.map((h) => <li>{h}</li>)}</ul>
      <h3>Équipements</h3>
      <ul class="amen-grid">{l.amenities.map((a) => <li>{a}</li>)}</ul>
    </div>
    <aside class="reveal">
      <div class="infobox sticky">
        <p class="eyebrow">Réservation</p>
        <h3 style="font-size:1.5rem;margin:8px 0 14px">{l.capacity} voyageurs</h3>
        <div class="row"><span>Type</span><b>{l.type}</b></div>
        {l.bedrooms && <div class="row"><span>Chambres</span><b>{l.bedrooms}</b></div>}
        {l.beds && <div class="row"><span>Couchages</span><b>{l.beds}</b></div>}
        {l.baths && <div class="row"><span>Salle de bain</span><b>{l.baths}</b></div>}
        <a href={l.airbnb} target="_blank" rel="noopener" class="btn btn-book" style="width:100%;text-align:center;margin-top:18px">Voir les disponibilités</a>
        <p class="book-note">Prix en temps réel sur Airbnb · <a href="/prix/" style="text-decoration:underline">grille tarifaire</a></p>
      </div>
    </aside>
  </div></section>

  <!-- POURQUOI -->
  <section class="spaces"><div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Pourquoi la Mare Ronde</p><h2>Bien plus qu'une simple location.</h2></div>
    <div class="why reveal">
      <div class="it"><div class="ic">🏡</div><h3>Un domaine privatif</h3><p>Un cadre de caractère rien que pour vous, au calme de la campagne sarthoise, à l'abri des regards.</p></div>
      <div class="it"><div class="ic">🏊</div><h3>Piscine, tennis &amp; pétanque</h3><p>Des activités sur place pour petits et grands, dans un vaste jardin clos arboré.</p></div>
      <div class="it"><div class="ic">🏁</div><h3>À 15 min du circuit</h3><p>Idéalement situé pour les 24 Heures du Mans, le Grand Prix moto et la visite du Mans.</p></div>
    </div>
  </div></section>

  <!-- GALERIE -->
  <section><div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Galerie</p><h2>{l.name} en images</h2></div>
    <div class="pgrid reveal">
      {gallery.map((p, i) => (<div class="imgwrap"><img class="cover" loading="lazy" src={p} alt={`${l.name} — photo ${i + 2}`} /></div>))}
    </div>
  </div></section>

  <!-- À PROXIMITÉ -->
  <section class="loc"><div class="wrap grid">
    <div class="reveal">
      <p class="eyebrow">À proximité</p>
      <h2>Au vert, et tout près du Mans.</h2>
      <ul class="dist">{site.distances.map((d) => (<li><span>{d.place}</span><span>{d.time}</span></li>))}</ul>
    </div>
    <iframe class="mapframe" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Carte — Yvré-l'Évêque" src="https://www.google.com/maps?q=Yvr%C3%A9-l%27%C3%89v%C3%AAque%2C%20Sarthe&output=embed"></iframe>
  </div></section>

  <!-- AUTRES GÎTES -->
  <section class="spaces"><div class="wrap">
    <div class="sec-head reveal"><p class="eyebrow">Le domaine</p><h2>Les autres gîtes</h2></div>
    <div class="cards">
      {others.map((o) => (
        <article class="card reveal">
          <a href={`/hebergements/${o.slug}/`} class="imgwrap" style="display:block"><img class="cover" loading="lazy" src={o.photos[0]} alt={o.name} /></a>
          <div class="body">
            <p class="eyebrow" style="font-size:.64rem">{o.type}</p>
            <h3 style="margin-top:6px">{o.name}</h3>
            <p>{o.tagline}</p>
            <a href={`/hebergements/${o.slug}/`} class="btn btn-dark" style="margin-top:12px;padding:11px 18px">Découvrir</a>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <!-- FAQ -->
  <section class="faq"><div class="wrap">
    <div class="sec-head reveal" style="margin-bottom:24px"><p class="eyebrow">Questions fréquentes</p><h2>À propos de {l.name}</h2></div>
    <div class="reveal" style="max-width:860px">
      {l.faq.map((f, i) => (<details open={i === 0}><summary>{f.q}</summary><p class="ans">{f.a}</p></details>))}
    </div>
  </div></section>

  <!-- CTA -->
  <section class="cta"><div class="wrap reveal">
    <p class="eyebrow">Votre séjour</p>
    <h2>Envie de réserver {l.name} ?</h2>
    <p>Disponibilités et prix en temps réel sur Airbnb.</p>
    <a href={l.airbnb} target="_blank" rel="noopener" class="btn btn-book">Réserver sur Airbnb</a>
  </div></section>
</BaseLayout>
