---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listings } from '../../data/listings';
import { site } from '../../data/site';
---
<BaseLayout
  title={`Nos hébergements — ${site.name} à ${site.city}`}
  description="Découvrez les 3 gîtes de la Mare Ronde : le domaine entier (16 pers.), Le Jardin (4 pers.) et L'Escapade (2 pers.). Réservation sur Airbnb."
  path="/hebergements/"
>
  <section class="page-hero"><div class="wrap">
    <p class="breadcrumb"><a href="/">Accueil</a> › Hébergements</p>
    <p class="eyebrow">Nos hébergements</p>
    <h1>Trois gîtes, un même domaine.</h1>
    <p>Louez le domaine entier pour vos grandes occasions, ou l'un des appartements pour une escapade plus intime. À {site.city}, près du Mans.</p>
  </div></section>

  <section><div class="wrap">
    <div class="cards" style="margin-top:0">
      {listings.map((l) => (
        <article class="card reveal">
          <a href={`/hebergements/${l.slug}/`} class="imgwrap" style="display:block">
            <img class="cover" loading="lazy" src={l.photos[0]} alt={l.name} />
          </a>
          <div class="body">
            <p class="eyebrow" style="font-size:.66rem">{l.type}</p>
            <h3 style="margin-top:6px">{l.name}</h3>
            <p>{l.tagline}</p>
            <div class="specs dark" style="margin:14px 0 16px">
              <span>👥 {l.capacity} voyageurs</span>
              {l.bedrooms && <span>🛏 {l.bedrooms}</span>}
              {l.baths && <span>🛁 {l.baths}</span>}
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap">
              <a href={`/hebergements/${l.slug}/`} class="btn btn-dark" style="padding:12px 20px">Découvrir</a>
              <a href={l.airbnb} target="_blank" rel="noopener" class="btn btn-book" style="padding:12px 20px">Réserver</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <section class="cta"><div class="wrap reveal">
    <p class="eyebrow">Une question ?</p>
    <h2>Nous vous aidons à choisir.</h2>
    <p>Selon le nombre de convives et l'occasion, nous vous orientons vers l'hébergement idéal.</p>
    <a href="/contact/" class="btn btn-primary">Nous contacter</a>
  </div></section>
</BaseLayout>
