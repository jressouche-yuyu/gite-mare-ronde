---
import V2Layout from '../../../layouts/V2Layout.astro';
import { v2Gites } from '../../../data/v2';
import { site } from '../../../data/site';
import { withBase } from '../../../lib/url';

export function getStaticPaths() {
  return v2Gites.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const path = `/v2/gites/${g.slug}/`;
const gallery = g.photos.slice(1, 13);
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Accommodation',
  name: g.name, description: g.body[0],
  url: new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + path, site.domain).href,
  image: g.photos.slice(0, 6).map((p) => new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + p, site.domain).href),
};
---
<V2Layout title={g.metaTitle} description={g.metaDescription} path={path} ogImage={g.photos[0]} jsonld={jsonld}>
  <div class="v-band"><img src={withBase(g.photos[0])} alt={g.name} /></div>

  <section class="v-sec"><div class="v-wrap" style="display:grid;grid-template-columns:1.5fr .8fr;gap:50px;align-items:start">
    <div class="v-prose v-reveal">
      <p class="v-eyebrow">{g.badge}</p>
      <h1 style="font-size:clamp(2rem,4vw,2.8rem);margin:8px 0 6px">{g.name}</h1>
      <p style="font-style:italic;color:var(--v-terra);font-size:1.15rem;margin-bottom:20px">{g.accroche}</p>
      {g.body.map((p) => <p>{p}</p>)}
      <h2>Capacité</h2>
      <p>{g.capacity}</p>
      <h2>Équipements</h2>
      <div class="v-badges">{g.amenities.map((a) => <span class="v-badge">{a}</span>)}</div>
    </div>
    <aside class="v-reveal">
      <div style="border:1px solid var(--v-rose);border-radius:6px;padding:26px;position:sticky;top:90px;background:var(--v-blanc)">
        <p class="v-eyebrow">Réservation</p>
        <p style="margin:8px 0 16px;color:var(--v-gris)">{g.spec}</p>
        <a href={g.airbnb} target="_blank" rel="noopener" class="v-btn v-btn-book" style="width:100%;text-align:center">Réserver sur Airbnb</a>
        <p style="font-size:.78rem;color:var(--v-gris);margin-top:10px">Disponibilités et prix en temps réel sur Airbnb.</p>
      </div>
    </aside>
  </div></section>

  <section class="v-sec alt"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Galerie</p><h2>{g.name} en images</h2><div class="v-rule"></div></div>
    <div class="v-grid v-reveal">
      {gallery.map((p, i) => <img src={withBase(p)} alt={`${g.name} — photo ${i + 2}`} loading="lazy" />)}
    </div>
  </div></section>

  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>Envie de réserver {g.name} ?</h2>
    <p>Consultez les disponibilités en direct sur Airbnb.</p>
    <a href={g.airbnb} target="_blank" rel="noopener" class="v-btn v-btn-book">Réserver sur Airbnb</a>
  </div></section>
</V2Layout>
