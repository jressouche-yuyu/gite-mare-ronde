---
import V2Layout from '../../layouts/V2Layout.astro';
import { v2Gites } from '../../data/v2';
import { withBase } from '../../lib/url';
---
<V2Layout
  title="Nos Gîtes — La Mare Ronde, Yvré-l’Évêque (Sarthe)"
  description="Découvrez les 3 gîtes de caractère de La Mare Ronde : Le Grand Gîte (16 pers.), L’Escapade (2 pers.) et Le Jardin (4 pers.). Piscine, tennis, pétanque."
  path="/v2/nos-gites/"
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">Nos hébergements</p>
    <h1>Trois gîtes, un même domaine</h1>
    <p>Louez le domaine entier pour vos grandes occasions, ou l’un des appartements pour une escapade plus intime — à Yvré-l’Évêque, près du Mans.</p>
  </div></section>

  <section class="v-sec"><div class="v-wrap">
    <div class="v-gites">
      {v2Gites.map((g) => (
        <article class="v-gcard v-reveal">
          <a href={withBase(`/v2/gites/${g.slug}/`)} class="ph"><img src={withBase(g.photos[0])} alt={g.name} loading="lazy" /></a>
          <div class="hd">{g.name}</div>
          <div class="bd">
            <p class="spec">{g.spec}</p>
            <p style="font-style:italic;color:var(--v-terra);margin-bottom:12px">{g.tagline}</p>
            <div class="links">
              <a href={withBase(`/v2/gites/${g.slug}/`)} class="v-btn v-btn-dark" style="padding:10px 16px">Découvrir</a>
              <a href={g.airbnb} target="_blank" rel="noopener" class="v-btn v-btn-book" style="padding:10px 16px">Réserver</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div></section>
</V2Layout>
