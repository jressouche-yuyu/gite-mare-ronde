---
import V2Layout from '../../layouts/V2Layout.astro';
import { site } from '../../data/site';
import { booking } from '../../data/booking';
import { withBase } from '../../lib/url';
---
<V2Layout
  title="Contact — La Mare Ronde, Gîtes à Yvré-l’Évêque (Sarthe)"
  description="Contactez La Mare Ronde pour toute question sur nos gîtes de caractère à Yvré-l’Évêque. Formulaire, coordonnées et liens de réservation Airbnb."
  path="/v2/contact/"
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">Contact</p>
    <h1>Nous contacter</h1>
    <p>Une question sur nos gîtes, nos disponibilités ou pour un séjour sur mesure ? Écrivez-nous, nous répondons sous 24 à 48 h.</p>
  </div></section>

  <section class="v-sec"><div class="v-wrap v-2col v-reveal" style="align-items:start">
    <div>
      <form class="v-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="Contact — La Mare Ronde (V2)" />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="text" name="nom" placeholder="Nom & Prénom *" required />
        <input type="email" name="email" placeholder="Adresse email *" required />
        <input type="tel" name="telephone" placeholder="Téléphone" />
        <select name="gite">
          <option value="">Gîte souhaité…</option>
          <option>Le Grand Gîte</option>
          <option>L’Escapade</option>
          <option>Le Jardin</option>
          <option>Pas encore décidé</option>
        </select>
        <input type="text" name="dates" placeholder="Dates de séjour envisagées" />
        <textarea name="message" rows="4" placeholder="Votre message *" required></textarea>
        <label class="rgpd"><input type="checkbox" required style="width:auto" /> J’accepte que mes données soient utilisées pour traiter ma demande (RGPD).</label>
        <button type="submit" class="v-btn v-btn-primary" style="border:0">Envoyer le message</button>
      </form>
      <p style="font-size:.8rem;color:var(--v-gris);margin-top:12px"><em>Formulaire via Web3Forms — coller la clé dans <code>src/data/site.ts</code>.</em></p>
    </div>
    <div>
      <iframe class="v-mapframe" loading="lazy" title="Carte — Yvré-l’Évêque" src="https://www.google.com/maps?q=Yvr%C3%A9-l%27%C3%89v%C3%AAque%2C%20Sarthe&output=embed"></iframe>
      <div style="margin-top:18px;color:var(--v-brun)">
        <p>📍 {site.city} ({site.postalCode}), {site.department}</p>
        <p>📧 contact@lamareronde.fr</p>
        <p>📞 {site.phone}</p>
      </div>
      <h4 style="font-family:var(--v-serif);color:var(--v-terra);margin:18px 0 10px">Réserver directement</h4>
      <div style="display:grid;gap:8px;max-width:280px">
        <a href={booking.domaine} target="_blank" rel="noopener" class="v-btn v-btn-book">Le Grand Gîte →</a>
        <a href={booking.escapade} target="_blank" rel="noopener" class="v-btn v-btn-book">L’Escapade →</a>
        <a href={booking.jardin} target="_blank" rel="noopener" class="v-btn v-btn-book">Le Jardin →</a>
      </div>
    </div>
  </div></section>
</V2Layout>
