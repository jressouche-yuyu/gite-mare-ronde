---
import V3Layout from '../layouts/V3Layout.astro';
import data from '../content/acces/acces.json';

const seo = (data as any).seo ?? {};
const { hero, mapEmbed, distancesHeading, distances, address, sections } = data as any;
---
<V3Layout
  title={seo.metaTitle || data.title}
  description={seo.metaDescription || ''}
  path="/acces/"
  noindex={seo.noindex}
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p>{hero.intro}</p>
  </div></section>

  <section class="v-sec"><div class="v-wrap v-2col v-reveal">
    <iframe class="v-mapframe" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Carte — accès au domaine" src={mapEmbed}></iframe>
    <div>
      <p class="v-eyebrow">Distances</p>
      <h2>{distancesHeading}</h2>
      <ul class="v-dist">
        {distances.map((d: any) => (<li><span>{d.place}</span><span>{d.time}</span></li>))}
      </ul>
      <p style="margin-top:20px;color:#3a2c28">Adresse : {address}</p>
    </div>
  </div></section>

  <section class="v-sec alt"><div class="v-wrap v-prose v-reveal" style="margin:0 auto">
    {sections.map((s: any) => (<><h2>{s.heading}</h2><p>{s.body}</p></>))}
  </div></section>
</V3Layout>
