---
import V3Layout from '../layouts/V3Layout.astro';
import { withBase } from '../lib/url';
import data from '../content/legite/legite.json';

const seo = (data as any).seo ?? {};
const { hero, presentation, spaces, equipment, gallery, cta } = data as any;
---
<V3Layout
  title={seo.metaTitle || data.title}
  description={seo.metaDescription || ''}
  path="/le-gite/"
  ogImage="/uploads/domaine/01.jpg"
  noindex={seo.noindex}
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p>{hero.intro}</p>
  </div></section>

  <section class="v-sec"><div class="v-wrap v-story v-reveal">
    <div class="imgs">
      <img src={withBase(presentation.image1?.src)} alt={presentation.image1?.alt || ''} />
      <img src={withBase(presentation.image2?.src)} alt={presentation.image2?.alt || ''} />
    </div>
    <div>
      <p class="v-eyebrow">{presentation.eyebrow}</p>
      <h2>{presentation.heading}</h2>
      {(presentation.paragraphs || []).map((p: string) => <p set:html={p} />)}
      <a href={withBase(presentation.ctaHref)} class="v-btn v-btn-dark" style="margin-top:8px">{presentation.ctaLabel}</a>
    </div>
  </div></section>

  <section class="v-sec alt"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">{spaces.eyebrow}</p><h2>{spaces.heading}</h2><div class="v-rule"></div><p>{spaces.intro}</p></div>
    <div class="v-spaces v-reveal">
      {(spaces.cards || []).map((c: any) => (
        <article class="sp">
          <div class="ph"><img src={withBase(c.image?.src)} alt={c.image?.alt || ''} loading="lazy" /></div>
          <div class="bd"><h3>{c.title}</h3><p>{c.text}</p></div>
        </article>
      ))}
    </div>
    <div class="v-amenrow v-reveal">
      {(equipment || []).map((e: any) => (<span class="chip"><span class="em">{e.ic}</span>{e.name}</span>))}
    </div>
  </div></section>

  <section class="v-sec"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">{gallery.eyebrow}</p><h2>{gallery.heading}</h2><div class="v-rule"></div></div>
    <div class="v-grid v-reveal">
      {(gallery.photos || []).map((p: string) => (<img src={withBase(p)} alt={gallery.heading} loading="lazy" />))}
    </div>
    <div style="text-align:center;margin-top:28px"><a href={withBase(gallery.ctaHref)} class="v-btn v-btn-dark">{gallery.ctaLabel}</a></div>
  </div></section>

  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>{cta.heading}</h2>
    <p>{cta.text}</p>
    <a href={withBase(cta.buttonHref)} class="v-btn v-btn-ghost" style="border-color:rgba(255,255,255,.7)">{cta.buttonLabel}</a>
  </div></section>
</V3Layout>
