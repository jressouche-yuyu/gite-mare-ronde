---
import V3Layout from '../layouts/V3Layout.astro';
import { listings } from '../data/listings';
import { withBase } from '../lib/url';
import data from '../content/galerie/galerie.json';

const seo = (data as any).seo ?? {};
const { hero, cta } = data as any;
---
<V3Layout
  title={seo.metaTitle || data.title}
  description={seo.metaDescription || ''}
  path="/galerie/"
  ogImage="/uploads/domaine/01.jpg"
  noindex={seo.noindex}
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p>{hero.intro}</p>
  </div></section>

  {listings.map((l, idx) => (
    <section class={`v-sec${idx % 2 ? ' alt' : ''}`}><div class="v-wrap">
      <div class="v-head v-reveal"><p class="v-eyebrow">{l.type}</p><h2>{l.name}</h2><div class="v-rule"></div></div>
      <div class="v-grid v-reveal">
        {l.photos.slice(0, 30).map((p, i) => (<img src={withBase(p)} alt={`${l.name} — photo ${i + 1}`} loading="lazy" decoding="async" />))}
      </div>
      <div style="text-align:center;margin-top:24px"><a href={withBase(`/gites/${l.slug}/`)} class="v-btn v-btn-dark">Découvrir {l.name}</a></div>
    </div></section>
  ))}

  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>{cta.heading}</h2>
    <p>{cta.text}</p>
    <a href={withBase(cta.buttonHref)} class="v-btn v-btn-ghost" style="border-color:rgba(255,255,255,.7)">{cta.buttonLabel}</a>
  </div></section>
</V3Layout>
