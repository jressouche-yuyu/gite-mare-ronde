---
import V3Layout from '../../layouts/V3Layout.astro';
import { withBase } from '../../lib/url';
import data from '../../content/apropos/apropos.json';

const seo = (data as any).seo ?? {};
const { hero, story, valuesHeading, values } = data as any;
---
<V3Layout
  title={seo.metaTitle || data.title}
  description={seo.metaDescription || ''}
  path="/v3/qui-sommes-nous/"
  noindex={seo.noindex}
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
  </div></section>

  <section class="v-sec"><div class="v-wrap v-story v-reveal">
    <div class="imgs">
      <img src={withBase(story.image1?.src)} alt={story.image1?.alt || ''} />
      <img src={withBase(story.image2?.src)} alt={story.image2?.alt || ''} />
    </div>
    <div>
      {story.quote && <p class="v-quote" style="text-align:left;margin:0 0 18px">« {story.quote} »</p>}
      {(story.paragraphs || []).map((p: string) => <p>{p}</p>)}
    </div>
  </div></section>

  <section class="v-sec alt"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Ce qui nous tient à cœur</p><h2>{valuesHeading}</h2><div class="v-rule"></div></div>
    <div class="v-amen v-reveal">
      {values.map((v: any) => (
        <div class="it"><div class="ic">{v.icon}</div><h3>{v.name}</h3><p>{v.desc}</p></div>
      ))}
    </div>
  </div></section>
</V3Layout>
