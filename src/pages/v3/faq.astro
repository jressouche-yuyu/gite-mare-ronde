---
import V3Layout from '../../layouts/V3Layout.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

const faq = [
  { q: 'Où se situe le Gîte de la Mare Ronde ?', a: `À ${site.city}, dans la ${site.department} (72), à environ 10 minutes du centre du Mans, en pleine campagne.` },
  { q: 'Combien de personnes le gîte peut-il accueillir ?', a: `Jusqu’à ${site.capacityMax} personnes dans ${site.bedrooms} chambres (${site.beds} couchages, ${site.baths} salles de bain). Les appartements se louent aussi séparément (2 et 4 personnes).` },
  { q: 'Y a-t-il une piscine et un terrain de tennis ?', a: 'Oui, le domaine dispose d’une piscine et d’un terrain de tennis privatifs, ainsi que d’un grand parc arboré et d’un terrain de pétanque.' },
  { q: 'Peut-on organiser un mariage ou une réception ?', a: 'La capacité et le cadre s’y prêtent (mariages, anniversaires, réunions de famille). Le domaine se loue en formule événement sur devis.' },
  { q: 'Le gîte est-il proche du circuit des 24 Heures du Mans ?', a: 'Oui, à environ 15 minutes : c’est un point de chute idéal pour les 24 Heures et les événements du circuit.' },
  { q: 'Quel est le budget pour louer le gîte ?', a: 'Le tarif dépend de la saison et de la durée. Consultez la page Prix ou demandez un devis personnalisé.' },
  { q: 'Les animaux sont-ils acceptés ?', a: 'À préciser avec le propriétaire lors de la réservation.' },
  { q: 'Comment réserver ?', a: 'La réservation et les prix en temps réel se font sur Airbnb. Pour un événement, contactez-nous pour un devis.' },
];
const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<V3Layout
  title={`FAQ — ${site.name}`}
  description="Questions fréquentes sur le Gîte de la Mare Ronde : localisation, capacité, piscine, tennis, mariage, tarifs et réservation."
  path="/v3/faq/"
  jsonld={faqJsonLd}
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">Questions fréquentes</p>
    <h1>Tout savoir avant de réserver</h1>
  </div></section>

  <section class="v-sec"><div class="v-wrap">
    <div class="v-faq v-reveal">
      {faq.map((f) => (<details><summary>{f.q}</summary><div class="ans">{f.a}</div></details>))}
    </div>
  </div></section>

  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>Une autre question ?</h2>
    <p>Nous sommes à votre écoute pour préparer votre séjour.</p>
    <a href={withBase('/v3/contact/')} class="v-btn v-btn-ghost" style="border-color:rgba(255,255,255,.7)">Nous contacter</a>
  </div></section>
</V3Layout>
