---
import V3Layout from '../../layouts/V3Layout.astro';
import { site } from '../../data/site';
---
<V3Layout title={`Politique de confidentialité — ${site.name}`} description="Politique de confidentialité et gestion des données du Gîte de la Mare Ronde." path="/v3/confidentialite/">
  <section class="v-phero"><div class="v-wrap">
    <h1>Politique de confidentialité</h1>
  </div></section>
  <section class="v-sec"><div class="v-wrap v-prose v-reveal" style="margin:0 auto">
    <h2>Données collectées</h2>
    <p>Les informations transmises via le formulaire de contact (nom, e-mail, dates, message) servent uniquement à traiter votre demande de séjour.</p>
    <h2>Vos droits (RGPD)</h2>
    <p>Vous disposez d’un droit d’accès, de rectification et de suppression de vos données. Contact : {site.email}.</p>
    <h2>Cookies</h2>
    <p><em>(À compléter selon les outils de mesure d’audience utilisés.)</em></p>
  </div></section>
</V3Layout>
