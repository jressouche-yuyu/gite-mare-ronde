---
import V3Layout from '../../layouts/V3Layout.astro';
import { site } from '../../data/site';
import { booking } from '../../data/booking';
import { listings } from '../../data/listings';
import { reviews, equipment, homeFaq } from '../../data/v3';
import { withBase } from '../../lib/url';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<V3Layout
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  path="/v3/"
  ogImage="/photos/domaine/01.jpg"
  jsonld={faqJsonLd}
>
  <!-- HERO -->
  <section class="v-hero">
    <div class="photo"><img src={withBase('/photos/domaine/01.jpg')} alt="Le domaine de la Mare Ronde, sa ferme en pierre et sa piscine" /></div>
    <div class="v-wrap">
      <p class="v-eyebrow">{site.city} · {site.department}</p>
      <h1>Une ferme d’autrefois, cachée dans la verdure</h1>
      <div class="v-rule"></div>
      <p class="lede">Trois gîtes de charme, une piscine, un court de tennis et un vaste jardin — à deux pas du Mans et à 15 min du circuit des 24 Heures. Pour les familles, les groupes et les grandes occasions.</p>
      <div class="actions">
        <a href={withBase('/v3/nos-gites/')} class="v-btn v-btn-primary">Découvrir nos gîtes</a>
        <a href={booking.primary} target="_blank" rel="noopener" class="v-btn v-btn-ghost">Réserver sur Airbnb</a>
      </div>
    </div>
  </section>

  <!-- NOTRE DOMAINE -->
  <section class="v-sec"><div class="v-wrap v-story v-reveal">
    <div class="imgs">
      <img src={withBase('/photos/domaine/01.jpg')} alt="Extérieur du domaine et sa piscine" />
      <img src={withBase('/photos/domaine/04.jpg')} alt="Salle à manger de caractère à poutres et cheminée" />
    </div>
    <div>
      <p class="v-eyebrow">Notre domaine</p>
      <h2>Un domaine de caractère, rénové avec âme</h2>
      <p>Dissimulés derrière les arbres, à {site.city}, Les Gîtes de la Mare Ronde réunissent trois logements élégants au sein d’une authentique propriété de caractère : pierre, poutres, tomettes et grands volumes.</p>
      <p>On s’y réveille au calme, on partage de longues tablées, on profite de la piscine et du jardin — loin de l’agitation, mais à quelques minutes du Mans.</p>
      <a href={withBase('/v3/nos-gites/')} class="v-btn v-btn-dark" style="margin-top:8px">Découvrir les 3 gîtes</a>
    </div>
  </div></section>

  <!-- 3 GÎTES (cartes enrichies V1) -->
  <section class="v-sec alt"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Nos hébergements</p><h2>Trois gîtes, un même domaine</h2><div class="v-rule"></div><p>Le domaine entier pour vos grandes occasions, ou un appartement pour une escapade intime.</p></div>
    <div class="v-gites">
      {listings.map((l) => (
        <article class={`v-gcard v-reveal${l.featured ? ' featured' : ''}`}>
          <a href={withBase(`/v3/gites/${l.slug}/`)} class="ph"><img src={withBase(l.photos[0])} alt={l.name} loading="lazy" /></a>
          <div class="hd"><span class="tag">{l.type}</span>{l.name}</div>
          <div class="bd">
            <p class="tagline">{l.tagline}</p>
            <div class="v-specs">
              <span>👥 {l.capacity} pers.</span>
              {l.bedrooms && <span>🛏 {l.bedrooms}</span>}
              {l.baths && <span>🛁 {l.baths}</span>}
            </div>
            <div class="links">
              <a href={withBase(`/v3/gites/${l.slug}/`)} class="v-btn v-btn-dark" style="padding:10px 16px">Découvrir</a>
              <a href={l.airbnb} target="_blank" rel="noopener" class="v-btn v-btn-book" style="padding:10px 16px">Réserver</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div></section>

  <!-- ÉQUIPEMENTS -->
  <section class="v-sec"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Équipements partagés</p><h2>Des espaces pensés pour se retrouver</h2><div class="v-rule"></div></div>
    <div class="v-amen v-reveal">
      {equipment.map((e) => (
        <div class="it"><div class="ic">{e.ic}</div><h3>{e.name}</h3><p>{e.desc}</p></div>
      ))}
    </div>
  </div></section>

  <!-- BANDEAU -->
  <div class="v-band"><img src={withBase('/photos/domaine/02.jpg')} alt="Le bord de la piscine au soleil, face à la ferme" /></div>

  <!-- RÉGION -->
  <section class="v-sec alt"><div class="v-wrap v-2col v-reveal">
    <iframe class="v-mapframe" loading="lazy" title="Carte — Yvré-l’Évêque" src="https://www.google.com/maps?q=Yvr%C3%A9-l%27%C3%89v%C3%AAque%2C%20Sarthe&output=embed"></iframe>
    <div>
      <p class="v-eyebrow">La région</p>
      <h2>Aux portes du Mans, au cœur de la nature</h2>
      <p>Yvré-l’Évêque est une commune paisible à quelques minutes du Mans, dans la Sarthe, dans un cadre naturel préservé tout en restant proche des commodités.</p>
      <p>À découvrir aux alentours : le <strong>circuit des 24 Heures du Mans</strong> (à ~15 min), la cité Plantagenêt et la cathédrale Saint-Julien, les châteaux de la vallée du Loir, les marchés et la gastronomie sarthoise.</p>
    </div>
  </div></section>

  <!-- TÉMOIGNAGES -->
  <section class="v-sec"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Ils ont séjourné chez nous</p><h2>Avis de nos voyageurs</h2><div class="v-rule"></div></div>
    <div class="v-revs v-reveal">
      {reviews.map((r) => (
        <div class="v-rev"><div class="stars">{'★'.repeat(r.stars)}</div><p>« {r.text} »</p><div class="who">{r.who} · {r.via}</div></div>
      ))}
    </div>
  </div></section>

  <!-- FAQ -->
  <section class="v-sec alt"><div class="v-wrap">
    <div class="v-head v-reveal"><p class="v-eyebrow">Bon à savoir</p><h2>Questions fréquentes</h2><div class="v-rule"></div></div>
    <div class="v-faq v-reveal">
      {homeFaq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="ans">{f.a}</div>
        </details>
      ))}
    </div>
  </div></section>

  <!-- CTA -->
  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>Prêt à vivre La Mare Ronde ?</h2>
    <p>Réservez en direct sur Airbnb, ou écrivez-nous pour un séjour sur mesure.</p>
    <div class="actions" style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href={booking.primary} target="_blank" rel="noopener" class="v-btn v-btn-book">Réserver sur Airbnb</a>
      <a href={withBase('/v3/contact/')} class="v-btn v-btn-ghost" style="border-color:rgba(255,255,255,.7)">Nous contacter</a>
    </div>
  </div></section>
</V3Layout>
