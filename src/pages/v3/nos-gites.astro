---
import V3Layout from '../../layouts/V3Layout.astro';
import { listings } from '../../data/listings';
import { withBase } from '../../lib/url';
import data from '../../content/nosgites/nosgites.json';

const seo = (data as any).seo ?? {};
const { hero } = data as any;
---
<V3Layout
  title={seo.metaTitle || data.title}
  description={seo.metaDescription || ''}
  path="/v3/nos-gites/"
  ogImage="/uploads/domaine/01.jpg"
  noindex={seo.noindex}
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">{hero.eyebrow}</p>
    <h1>{hero.title}</h1>
    <p>{hero.intro}</p>
  </div></section>

  <section class="v-sec"><div class="v-wrap">
    <div class="v-gites">
      {listings.map((l) => (
        <article class={`v-gcard v-reveal${l.featured ? ' featured' : ''}`}>
          <a href={withBase(`/v3/gites/${l.slug}/`)} class="ph"><img src={withBase(l.photos[0])} alt={l.name} loading="lazy" /></a>
          <div class="hd"><span class="tag">{l.type}</span>{l.name}</div>
          <div class="bd">
            <p class="tagline">{l.tagline}</p>
            <div class="v-specs">
              <span>👥 {l.capacity} pers.</span>
              {l.bedrooms && <span>🛏 {l.bedrooms}</span>}
              {l.baths && <span>🛁 {l.baths}</span>}
            </div>
            <div class="links">
              <a href={withBase(`/v3/gites/${l.slug}/`)} class="v-btn v-btn-dark" style="padding:10px 16px">Découvrir</a>
              <a href={l.airbnb} target="_blank" rel="noopener" class="v-btn v-btn-book" style="padding:10px 16px">Réserver</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div></section>
</V3Layout>
