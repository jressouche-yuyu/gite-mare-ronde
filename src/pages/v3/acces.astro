---
import V3Layout from '../../layouts/V3Layout.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';
---
<V3Layout
  title={`Accès & itinéraire — ${site.name}`}
  description="Comment venir au Gîte de la Mare Ronde à Yvré-l’Évêque : accès depuis Le Mans, le circuit des 24 Heures, la gare TGV."
  path="/v3/acces/"
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">Situation & accès</p>
    <h1>Comment venir au domaine</h1>
    <p>Au vert, à {site.city}, et pourtant tout près du Mans et du circuit.</p>
  </div></section>

  <section class="v-sec"><div class="v-wrap v-2col v-reveal">
    <iframe class="v-mapframe" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Carte — Yvré-l’Évêque, Sarthe" src="https://www.google.com/maps?q=Yvr%C3%A9-l%27%C3%89v%C3%AAque%2C%20Sarthe&output=embed"></iframe>
    <div>
      <p class="v-eyebrow">Distances</p>
      <h2>À deux pas de l’essentiel</h2>
      <ul class="v-dist">
        {site.distances.map((d) => (<li><span>{d.place}</span><span>{d.time}</span></li>))}
      </ul>
      <p style="margin-top:20px;color:#3a2c28">Adresse : {site.city} ({site.postalCode}), {site.department}.</p>
    </div>
  </div></section>

  <section class="v-sec alt"><div class="v-wrap v-prose v-reveal" style="margin:0 auto">
    <h2>En voiture</h2>
    <p>Depuis Le Mans, rejoignez {site.city} en une dizaine de minutes. <em>(Itinéraire détaillé à compléter.)</em></p>
    <h2>En train</h2>
    <p>Gare du Mans à 1 h de Paris en TGV, puis quelques minutes jusqu’au domaine.</p>
  </div></section>
</V3Layout>
