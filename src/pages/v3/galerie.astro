---
import V3Layout from '../../layouts/V3Layout.astro';
import { site } from '../../data/site';
import { listings } from '../../data/listings';
import { withBase } from '../../lib/url';
---
<V3Layout
  title={`Galerie photos — ${site.name} à ${site.city}`}
  description="Photos des Gîtes de la Mare Ronde : piscine, tennis, jardin, intérieurs de charme à Yvré-l’Évêque, près du Mans."
  path="/v3/galerie/"
  ogImage="/photos/domaine/01.jpg"
>
  <section class="v-phero"><div class="v-wrap">
    <p class="v-eyebrow" style="color:var(--v-rose)">Galerie</p>
    <h1>Le domaine en images</h1>
    <p>Le domaine, ses extérieurs et ses trois gîtes de charme.</p>
  </div></section>

  {listings.map((l, idx) => (
    <section class={`v-sec${idx % 2 ? ' alt' : ''}`}><div class="v-wrap">
      <div class="v-head v-reveal"><p class="v-eyebrow">{l.type}</p><h2>{l.name}</h2><div class="v-rule"></div></div>
      <div class="v-grid v-reveal">
        {l.photos.slice(0, 30).map((p, i) => (<img src={withBase(p)} alt={`${l.name} — photo ${i + 1}`} loading="lazy" decoding="async" />))}
      </div>
      <div style="text-align:center;margin-top:24px"><a href={withBase(`/v3/gites/${l.slug}/`)} class="v-btn v-btn-dark">Découvrir {l.name}</a></div>
    </div></section>
  ))}

  <section class="v-sec v-cta"><div class="v-wrap v-reveal">
    <h2>Ces images vous parlent ?</h2>
    <p>Réservez en direct sur Airbnb, ou écrivez-nous pour un séjour sur mesure.</p>
    <a href={withBase('/v3/nos-gites/')} class="v-btn v-btn-ghost" style="border-color:rgba(255,255,255,.7)">Voir les hébergements</a>
  </div></section>
</V3Layout>
