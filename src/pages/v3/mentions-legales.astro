---
import V3Layout from '../../layouts/V3Layout.astro';
import { site } from '../../data/site';
---
<V3Layout title={`Mentions légales — ${site.name}`} description="Mentions légales du site du Gîte de la Mare Ronde." path="/v3/mentions-legales/">
  <section class="v-phero"><div class="v-wrap">
    <h1>Mentions légales</h1>
  </div></section>
  <section class="v-sec"><div class="v-wrap v-prose v-reveal" style="margin:0 auto">
    <h2>Éditeur</h2>
    <p>{site.name} — {site.city} ({site.postalCode}). <em>(Raison sociale, SIRET, directeur de publication à compléter.)</em></p>
    <h2>Hébergement</h2>
    <p><em>(Nom et coordonnées de l’hébergeur à compléter.)</em></p>
    <h2>Propriété intellectuelle</h2>
    <p>L’ensemble des contenus de ce site est protégé. Toute reproduction sans autorisation est interdite.</p>
  </div></section>
</V3Layout>
