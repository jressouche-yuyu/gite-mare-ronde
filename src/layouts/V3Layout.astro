---
import '../styles/v2.css';
import '../styles/v3.css';
import { site } from '../data/site';
import { booking } from '../data/booking';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** chemin relatif (ex: "/nos-gites/") pour l'URL canonique */
  path?: string;
  /** image de partage (Open Graph) */
  ogImage?: string;
  /** JSON-LD additionnel (objet ou tableau) */
  jsonld?: unknown;
  /** SEO : masquer des moteurs (false = indexable par défaut, site en production) */
  noindex?: boolean;
  /** En-tête transparent par-dessus un grand visuel sombre (accueil). Sinon en-tête plein (toujours lisible). */
  heroHeader?: boolean;
}
const { title, description, path = '', ogImage, jsonld, noindex = false, heroHeader = false } = Astro.props;
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
// Origine = `site` d'astro.config (source unique). Le jour de la connexion du domaine OVH :
// modifier `site` (+ base:'/') dans astro.config.mjs → canonical, OG et sitemap suivent automatiquement.
const origin = Astro.site ?? new URL(site.domain);
const canonical = new URL(baseNoSlash + path, origin).href;
const ogImageUrl = new URL(baseNoSlash + (ogImage || '/logo.png'), origin).href;

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/le-gite/', label: 'Le domaine' },
  { href: '/nos-gites/', label: 'Nos Gîtes' },
  { href: '/sejour/', label: 'Séjours' },
  { href: '/contact/', label: 'Contact' },
];

// JSON-LD établissement présent sur toutes les pages (richesse SEO/GEO héritée de la V1)
const lodging = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: site.description,
  url: new URL(baseNoSlash + '/', origin).href,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    postalCode: site.postalCode,
    addressRegion: site.region,
    addressCountry: 'FR',
  },
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Piscine', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Terrain de tennis', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Grand parc / jardin', value: true },
  ],
};
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#5C3A2E" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />

  <script type="application/ld+json" set:html={JSON.stringify(lodging)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body class="v2 v3">
  <header class:list={["v-header", { "solid": !heroHeader, "solid-locked": !heroHeader }]} id="v-header">
    <div class="bar">
      <a href={withBase('/')} class="v-logo">
        <img src={withBase('/logo-160.png')} alt="Logo La Mare Ronde" width="44" height="44" />
        <span class="t">La Mare Ronde<small>Gîtes de caractère</small></span>
      </a>
      <nav class="v-nav">
        <ul>
          {nav.map((n) => <li><a href={withBase(n.href)}>{n.label}</a></li>)}
          <li><a class="cta" href={booking.primary} target="_blank" rel="noopener">Réserver</a></li>
        </ul>
        <button class="v-burger" aria-label="Menu" aria-expanded="false">☰</button>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="v-footer">
    <div class="v-wrap">
      <div class="v-fgrid">
        <div>
          <div class="brand">La Mare Ronde</div>
          <p>Domaine de caractère à {site.city} ({site.postalCode}), Sarthe — trois gîtes, piscine, tennis et pétanque, à deux pas du Mans.</p>
          <p style="margin-top:10px"><a href={booking.primary} target="_blank" rel="noopener" style="color:var(--v-terra-light);font-weight:700">Réserver sur Airbnb →</a></p>
        </div>
        <div>
          <h4>Découvrir</h4>
          <ul>
            <li><a href={withBase('/le-gite/')}>Le domaine</a></li>
            <li><a href={withBase('/nos-gites/')}>Nos gîtes</a></li>
            <li><a href={withBase('/galerie/')}>Galerie photos</a></li>
            <li><a href={withBase('/prix/')}>Prix &amp; disponibilités</a></li>
          </ul>
        </div>
        <div>
          <h4>Séjourner</h4>
          <ul>
            <li><a href={withBase('/sejour/')}>Séjours &amp; événements</a></li>
            <li><a href={withBase('/capacite/')}>Par capacité</a></li>
            <li><a href={withBase('/location/')}>Par localisation</a></li>
            <li><a href={withBase('/faq/')}>Questions fréquentes</a></li>
          </ul>
        </div>
        <div>
          <h4>La Mare Ronde</h4>
          <ul>
            <li><a href={withBase('/qui-sommes-nous/')}>Qui sommes-nous</a></li>
            <li><a href={withBase('/acces/')}>Accès &amp; itinéraire</a></li>
            <li><a href={withBase('/contact/')}>Contact</a></li>
            <li><a href={withBase('/mentions-legales/')}>Mentions légales</a></li>
            <li><a href={withBase('/confidentialite/')}>Confidentialité</a></li>
          </ul>
        </div>
      </div>
      <div class="v-fbot">© 2026 La Mare Ronde · {site.city} (72)</div>
    </div>
  </footer>

  <script>
    const h = document.getElementById('v-header');
    const onS = () => { if (h && !h.classList.contains('solid-locked')) h.classList.toggle('solid', window.scrollY > 60); };
    onS(); addEventListener('scroll', onS, { passive: true });
    const b = h && h.querySelector('.v-burger');
    if (b) b.addEventListener('click', () => { const o = h.classList.toggle('nav-open'); b.textContent = o ? '✕' : '☰'; b.setAttribute('aria-expanded', o ? 'true' : 'false'); });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
    document.querySelectorAll('.v-reveal').forEach((el) => io.observe(el));
    // Lightbox (galeries .v-grid)
    const gi = Array.from(document.querySelectorAll('.v-grid img'));
    if (gi.length) {
      const ov = document.createElement('div'); ov.className = 'lightbox'; ov.innerHTML = '<button class="lb-close" aria-label="Fermer">✕</button><button class="lb-prev" aria-label="Précédent">‹</button><img class="lb-img" alt=""/><button class="lb-next" aria-label="Suivant">›</button>';
      document.body.appendChild(ov);
      const im = ov.querySelector('.lb-img'); let i = 0;
      const show = (n) => { i = (n + gi.length) % gi.length; im.setAttribute('src', gi[i].currentSrc || gi[i].src); im.setAttribute('alt', gi[i].alt || ''); };
      const open = (n) => { show(n); ov.classList.add('open'); document.body.style.overflow = 'hidden'; };
      const close = () => { ov.classList.remove('open'); document.body.style.overflow = ''; };
      gi.forEach((x, n) => x.addEventListener('click', () => open(n)));
      ov.querySelector('.lb-close').addEventListener('click', close);
      ov.querySelector('.lb-next').addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
      ov.querySelector('.lb-prev').addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
      ov.addEventListener('click', (e) => { if (e.target === ov) close(); });
      addEventListener('keydown', (e) => { if (!ov.classList.contains('open')) return; if (e.key === 'Escape') close(); else if (e.key === 'ArrowRight') show(i + 1); else if (e.key === 'ArrowLeft') show(i - 1); });
    }
  </script>
</body>
</html>
