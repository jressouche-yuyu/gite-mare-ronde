# En-têtes de sécurité (appliqués par Cloudflare Pages / Netlify ;
# ignorés par GitHub Pages — d'où l'intérêt de passer sur Cloudflare Pages + domaine).
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline'; frame-src https://www.google.com https://maps.google.com https://www.airbnb.fr; connect-src 'self' https://api.open-meteo.com https://api.web3forms.com; base-uri 'self'; form-action 'self' https://api.web3forms.com
